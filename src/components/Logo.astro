---
/**
 * Logo de l'atelier.
 *
 * ▶ POUR METTRE VOTRE LOGO : remplacez src/assets/images/brand/logo.png
 *   (256 × 256 px, fond transparent conseillé) en gardant le même nom.
 *   Aucun autre fichier n'est à modifier.
 */
import { Image } from 'astro:assets';
import { asset } from '../lib/images';
import { site } from '../data/site.mjs';

interface Props {
  size?: number;
  class?: string;
}
const { size = 44, class: className = '' } = Astro.props;
---

<Image
  src={asset('brand/logo.png')}
  alt={`Logo ${site.name}`}
  width={size}
  height={size}
  densities={[1, 2]}
  loading="eager"
  class:list={['logo', className]}
/>

<style>
  .logo {
    border-radius: 50%;
    object-fit: cover;
  }
</style>
