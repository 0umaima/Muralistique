---
import Icon from '../Icon.astro';
import BeforeAfter from '../BeforeAfter.astro';
import { homeBeforeAfter } from '../../data/projects';

const project = homeBeforeAfter();
---

{
  project?.beforeAfter && (
    <section class="transfo theme-ivory-2 section" id="transformations" data-section-theme="ivory">
      <div class="shell pad">
        <div class="section-head" data-reveal>
          <div>
            <p class="eyebrow">
              <Icon name="sparkle" size={13} stroke={1.6} />
              Avant / après
            </p>
            <h2 class="transfo__title">
              La preuve visuelle,
              <br />
              mur par mur.
            </h2>
          </div>
          <a class="btn btn--outline btn--md transfo__all" href="/realisations">
            Toutes les transformations
          </a>
        </div>

        <div class="transfo__body" data-reveal>
          <BeforeAfter
            id="home-ba"
            before={project.beforeAfter.before}
            after={project.beforeAfter.after}
            ratio="2 / 1"
          />

          <div class="transfo__meta">
            <div class="transfo__meta-head">
              <h3>{project.beforeAfter.label ?? project.title}</h3>
              <span class="muted">{project.beforeAfter.meta ?? project.city}</span>
            </div>
            <a class="link-underline" href={`/realisations/${project.slug}`}>
              Voir le projet
              <Icon name="arrow-up-right" size={13} stroke={2.2} />
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .transfo {
    margin-top: var(--section-y);
    border-top: 1px solid var(--ink);
  }
  .transfo__title { margin-top: 22px; font-size: var(--fs-h2); max-width: 820px; }
  .transfo__all { white-space: nowrap; }
  .transfo__body { margin-top: clamp(2rem, 3.3vw, 3rem); }

  .transfo__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--ink);
  }
  .transfo__meta-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    flex-wrap: wrap;
  }
  .transfo__meta-head h3 { font-size: var(--fs-h3); }
  .transfo__meta-head span { font: 500 var(--fs-small) / 1 var(--font-body); }
</style>
