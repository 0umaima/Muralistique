---
import Icon from '../Icon.astro';
import BeforeAfter from '../BeforeAfter.astro';
import { homeBeforeAfter } from '../../data/projects';

const project = homeBeforeAfter();
---

{
  project?.beforeAfter && (
    <section class="transfo theme-ivory section" id="transformations" data-section-theme="ivory">
      <div class="shell pad">
        <div class="section-head" data-reveal>
          <div>
            <p class="section-index">01</p>
            <h2 class="section-title">Avant / Après</h2>
          </div>
          <p class="section-head__aside">Glissez le curseur : le même mur, avant et après notre passage.</p>
        </div>

        <div class="transfo__body" data-reveal>
          <BeforeAfter
            id="home-ba"
            before={project.beforeAfter.before}
            after={project.beforeAfter.after}
            ratio="2 / 1"
          />

          <div class="transfo__meta">
            <div class="transfo__meta-head">
              <h3>{project.beforeAfter.label ?? project.title}</h3>
              <span class="muted">{project.beforeAfter.meta ?? project.city}</span>
            </div>
            <div class="transfo__links">
              <a class="link-underline" href={`/realisations/${project.slug}`}>
                Voir le projet
                <Icon name="arrow-up-right" size={13} stroke={2.2} />
              </a>
              <a class="link-underline" href="/realisations">
                Toutes les réalisations
                <Icon name="arrow-up-right" size={13} stroke={2.2} />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .transfo__body { margin-top: clamp(2rem, 3.3vw, 3rem); }

  .transfo__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px 32px;
    flex-wrap: wrap;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--ink);
  }
  .transfo__meta-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    flex-wrap: wrap;
  }
  .transfo__meta-head h3 { font-size: var(--fs-h3); }
  .transfo__meta-head span { font: 500 var(--fs-small) / 1 var(--font-body); }
  .transfo__links { display: flex; flex-wrap: wrap; gap: 28px; }
</style>
