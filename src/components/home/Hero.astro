---
import Icon from '../Icon.astro';
import Media from '../Media.astro';
import FixedBg from '../FixedBg.astro';
import heroCenterGif from '../../assets/images/home/hero-center.gif?url';

/**
 * Hero de l'accueil : un collage de trois grands visuels à angles francs,
 * le titre posé par-dessus leur bas, sur un fond photo fixe.
 *
 * À l'ouverture, les visuels se découvrent en cascade rapide (gauche,
 * centre, droite), directement sur le fond, puis le titre monte.
 * Pour changer une image : remplacez le fichier dans src/assets/images/home/
 * en gardant son nom.
 */
---

<section class="hero theme-ink" data-section-theme="ink">
  <FixedBg src="home/hero-bg.jpg" scrim={0.62} eager />

  <div class="hero__inner shell pad">
    <div class="hero__stage">
      <div class="hero__shot hero__shot--left">
        <Media
          src="home/hero-left.jpeg"
          alt="Fresque « Build Something » peinte dans un espace de travail"
          widths={[320, 480, 640, 900]}
          sizes="(max-width: 700px) 42vw, 26vw"
          eager
          position="center 40%"
          class="hero__media"
        />
      </div>

      <div class="hero__shot hero__shot--center">
        <img
          class="hero__gif"
          src={heroCenterGif}
          alt="Geste de peinture sur une fresque murale"
          width="720"
          height="1280"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="hero__shot hero__shot--right">
        <Media
          src="home/hero-right.jpeg"
          alt="Visage peint au trait noir sur des aplats jaune, rouge et bleu"
          widths={[320, 480, 640, 900]}
          sizes="(max-width: 700px) 42vw, 36vw"
          eager
          position="center 35%"
          class="hero__media"
        />
      </div>

      <svg class="hero__stroke hero__stroke--a" viewBox="0 0 220 420" fill="none" aria-hidden="true">
        <path pathLength="1" d="M14 404C120 330 206 250 196 150 186 52 104 8 40 30"></path>
      </svg>
      <svg class="hero__stroke hero__stroke--b" viewBox="0 0 320 220" fill="none" aria-hidden="true">
        <path pathLength="1" d="M8 212C52 120 120 40 212 22c48-9 84 6 100 30"></path>
      </svg>

      <h1 class="hero__title">
        <span class="hero__line hero__line--1">Fresques peintes</span>
        <span class="hero__line hero__line--2">à la main</span>
      </h1>
    </div>

    <div class="hero__actions">
      <a class="btn btn--accent" href="/devis">
        Demander un devis
        <Icon name="arrow-up-right" size={14} stroke={2.2} />
      </a>
      <a class="btn btn--ghost-light" href="/realisations">Voir les réalisations</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2rem, 4vw, 3.5rem);
    overflow: hidden;
    background: var(--ink);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ——— Scène du collage ———
     Toutes les positions sont en % de la scène, dont le format est fixe :
     le collage garde ses proportions à toutes les largeurs. */
  .hero__stage {
    position: relative;
    /* Largeur plafonnée par la hauteur d'écran : le collage et son titre
       tiennent dans la première vue, même sur un portable peu haut. */
    width: min(100%, 1320px, (100svh - var(--header-h) - 4.5rem) * 1320 / 740);
    aspect-ratio: 1320 / 740;
  }

  .hero__shot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    aspect-ratio: var(--ar);
    overflow: hidden;
    /* Aucun aplat derrière l'image : pendant l'ouverture, on voit le fond
       du hero, jamais une couleur. */
    background: transparent;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.65);
  }
  .hero__shot--left { --x: 2%; --y: 7%; --w: 25%; --ar: 3 / 4; z-index: 1; }
  .hero__shot--center { --x: 28.5%; --y: 0%; --w: 35%; --ar: 4 / 5; z-index: 2; }
  .hero__shot--right { --x: 60.5%; --y: 15%; --w: 36%; --ar: 1 / 1; z-index: 3; }

  .hero__shot :global(.hero__media),
  .hero__gif {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__gif { object-position: center 45%; }

  /* Traits d'accent, à la manière d'un coup de pinceau autour du collage */
  .hero__stroke {
    position: absolute;
    z-index: 4;
    overflow: visible;
    pointer-events: none;
  }
  .hero__stroke path {
    stroke: var(--accent);
    stroke-width: 7;
    stroke-linecap: round;
  }
  .hero__stroke--a { left: -3%; top: 34%; width: 13%; }
  .hero__stroke--b { right: -2%; bottom: 4%; width: 20%; }

  .hero__title {
    position: absolute;
    z-index: 5;
    left: 0;
    right: 0;
    bottom: 0;
    font-size: clamp(3rem, 8.6vw, 8rem);
    font-weight: 900;
    line-height: 0.86;
    text-align: center;
    color: var(--ivory);
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.45);
    pointer-events: none;
  }
  .hero__line { display: block; }
  .hero__line--2 { color: var(--accent); }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: clamp(1.5rem, 2.8vw, 2.5rem);
  }

  /* Tablette : la scène se resserre un peu en hauteur */
  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .hero__stage { width: 100%; aspect-ratio: 4 / 3; }
    .hero__shot--left { --x: 0%; --y: 10%; --w: 30%; }
    .hero__shot--center { --x: 27%; --y: 0%; --w: 42%; }
    .hero__shot--right { --x: 63%; --y: 16%; --w: 37%; }
    .hero__stroke--a { left: -4%; top: 44%; width: 16%; }
    .hero__stroke--b { width: 26%; }
  }

  /* Mobile : collage plus vertical, titre sur toute la largeur */
  @media (max-width: 600px) {
    .hero__stage { aspect-ratio: 4 / 5; }
    .hero__shot--left { --x: 0%; --y: 8%; --w: 40%; --ar: 3 / 4; }
    .hero__shot--center { --x: 26%; --y: 0%; --w: 50%; --ar: 3 / 4; }
    .hero__shot--right { --x: 58%; --y: 20%; --w: 42%; --ar: 3 / 4; }
    .hero__title { font-size: clamp(2.5rem, 12.4vw, 4.25rem); }
    .hero__stroke--a { display: none; }
    .hero__stroke--b { width: 34%; right: -4%; bottom: 30%; }
    .hero__actions { flex-direction: column; align-self: stretch; }
    .hero__actions :global(.btn) { width: 100%; }
  }

  /* ——— Entrée : cascade rapide ———
     Chaque cadre se découvre de bas en haut pendant que son image se
     resserre ; les trois cadres se chevauchent dans le temps (120 ms
     d'écart) et le titre monte avant la fin. Tout est en place en ~1,2 s.
     Uniquement quand JavaScript est actif : sans lui, tout est déjà là. */
  .hero__shot--left { --d: 0ms; }
  .hero__shot--center { --d: 120ms; }
  .hero__shot--right { --d: 240ms; }

  :global(.js) .hero__shot { animation: shot-open 750ms cubic-bezier(0.7, 0, 0.2, 1) var(--d) both; }
  :global(.js) .hero__shot :global(.hero__media),
  :global(.js) .hero__gif { animation: shot-zoom 1000ms var(--ease-out) var(--d) both; }

  :global(.js) .hero__stroke path { animation: stroke-draw 700ms var(--ease-out) 650ms both; }
  :global(.js) .hero__line--1 { animation: h-line 650ms var(--ease-out) 380ms both; }
  :global(.js) .hero__line--2 { animation: h-line 650ms var(--ease-out) 460ms both; }
  :global(.js) .hero__actions { animation: h-line 600ms var(--ease-out) 600ms both; }

  @keyframes shot-open {
    from { clip-path: inset(100% 0 0 0); transform: translateY(48px); }
    to { clip-path: inset(0 0 0 0); transform: none; }
  }
  @keyframes shot-zoom {
    from { transform: scale(1.18); }
    to { transform: none; }
  }
  @keyframes stroke-draw {
    from { stroke-dasharray: 1; stroke-dashoffset: 1; }
    to { stroke-dasharray: 1; stroke-dashoffset: 0; }
  }
  @keyframes h-line {
    from { opacity: 0; transform: translateY(32px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero__shot,
    :global(.js) .hero__shot :global(.hero__media),
    :global(.js) .hero__gif,
    :global(.js) .hero__stroke path,
    :global(.js) .hero__line--1,
    :global(.js) .hero__line--2,
    :global(.js) .hero__actions { animation: none; }
  }
</style>
