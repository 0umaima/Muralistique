---
import Icon from '../Icon.astro';
import Media from '../Media.astro';
import { sectors } from '../../data/sectors';

// Le défilement infini a besoin d'une copie exacte de la série.
const loop = [...sectors, ...sectors];
---

<section class="sectors theme-ivory" id="secteurs" data-section-theme="ivory">
  <div class="shell pad">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><Icon name="sparkle" size={13} stroke={1.6} />Secteurs</p>
        <h2 class="sectors__title">Une fresque pensée<br />pour chaque lieu.</h2>
      </div>
      <p class="section-head__aside">
        Chaque projet part du métier, du public et de l’identité du lieu. Le dessin s’adapte à l’espace, jamais
        l’inverse.
      </p>
    </div>
  </div>

  <div class="sectors__viewport">
    <ul class="sectors__track" data-marquee>
      {
        loop.map((sector, index) => {
          const isClone = index >= sectors.length;
          return (
            <li class="sectors__item" aria-hidden={isClone ? 'true' : undefined}>
              <a
                class="sectors__card"
                href={`/realisations?secteur=${sector.slug}`}
                tabindex={isClone ? -1 : undefined}
              >
                <Media
                  src={sector.image}
                  alt={isClone ? '' : sector.imageAlt}
                  widths={[280, 400, 632]}
                  sizes="(max-width: 700px) 232px, 316px"
                  zoom
                  class="sectors__media"
                />
                <span class="sectors__tag">{sector.label}</span>
                <span class="sectors__foot">
                  <span class="sectors__count">{sector.count} projets</span>
                  <span class="sectors__blurb">{sector.blurb}</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="sectors__controls shell pad">
    <button class="btn btn--outline btn--sm only-js" type="button" data-marquee-toggle aria-pressed="false">
      <Icon name="pause" size={14} stroke={2} />
      <span data-marquee-label>Mettre en pause</span>
    </button>
    <p class="sectors__hint muted">Défilement lent — la lecture s’arrête au survol.</p>
  </div>
</section>

<style>
  .sectors { padding-block: var(--section-y) 0; }
  .sectors__title { margin-top: 22px; font-size: var(--fs-h2); max-width: 760px; }

  .sectors__viewport {
    margin-top: clamp(1.5rem, 3vw, 2.75rem);
    padding-left: var(--gutter);
    overflow: hidden;
  }

  .sectors__track {
    display: flex;
    gap: 22px;
    width: max-content;
    padding-right: 22px;
    animation: marquee 60s linear infinite;
  }
  .sectors__viewport:hover .sectors__track,
  .sectors__viewport:focus-within .sectors__track { animation-play-state: paused; }
  .sectors__track[data-paused='true'] { animation-play-state: paused; }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .sectors__item { flex: 0 0 auto; }

  .sectors__card {
    position: relative;
    display: block;
    width: clamp(232px, 21.9vw, 316px);
    height: clamp(290px, 27.4vw, 395px);
    overflow: hidden;
    border-radius: clamp(18px, 1.67vw, 24px);
    border: 1px solid var(--ink);
  }
  .sectors__card :global(.media) { width: 100%; height: 100%; }

  .sectors__tag {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 9px 14px 8px;
    background: var(--ink);
    color: var(--ivory);
    font: 600 0.75rem/1 var(--font-body);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sectors__foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 16px 18px;
    background: var(--ivory);
    border-top: 1px solid var(--ink);
  }
  .sectors__count {
    display: block;
    font: 600 0.6875rem/1 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-on-light);
  }
  .sectors__blurb {
    display: block;
    margin-top: 6px;
    font-size: 0.84375rem;
    color: var(--ink);
  }

  .sectors__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    padding-top: 24px;
  }
  .sectors__hint { font-size: var(--fs-xs); }

  @media (max-width: 900px) {
    /* Sur petit écran, le rail se parcourt au doigt : pas d'animation. */
    .sectors__viewport { overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; }
    .sectors__track { animation: none; }
    .sectors__item { scroll-snap-align: start; }
    .sectors__item[aria-hidden='true'] { display: none; }
    .sectors__tag { top: 12px; left: 12px; padding: 7px 11px 6px; font-size: 0.625rem; }
    .sectors__foot { padding: 12px 14px; }
    .sectors__controls [data-marquee-toggle] { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sectors__viewport { overflow-x: auto; }
    .sectors__track { animation: none; }
  }
</style>

<script>
  import { initMarquee } from '../../scripts/marquee';
  initMarquee();
</script>
