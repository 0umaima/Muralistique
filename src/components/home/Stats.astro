---
import FixedBg from '../FixedBg.astro';
import { stats } from '../../data/content';
---

<section class="stats theme-ink" data-section-theme="ink" aria-label="Chiffres clés">
  <FixedBg src="projects/cafe-nord/cover.jpeg" scrim={0.74} />
  <ul class="stats__grid shell">
    {
      stats.map((stat, i) => (
        <li class="stats__item" data-reveal data-reveal-delay={i * 80}>
          {/* La valeur exacte est dans data-count : le compteur l'atteint puis
              restitue le texte tel quel (suffixe « + », « % », « j » compris). */}
          <span class="stats__value" data-count={stat.value}>{stat.value}</span>
          <span class="stats__label desktop-only">{stat.label}</span>
          <span class="stats__label mobile-only">{stat.shortLabel}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .stats {
    position: relative;
    isolation: isolate;
    border-top: 1px solid var(--ink-line);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .stats__item {
    padding: clamp(2.5rem, 7.5vw, 7rem) clamp(1.25rem, 2.8vw, 2.5rem);
    border-right: 1px solid rgba(255, 255, 255, 0.14);
  }
  .stats__item:last-child { border-right: 0; }

  .stats__value {
    display: block;
    font: 800 var(--fs-stat) / 1 var(--font-display);
    letter-spacing: var(--ls-display);
    color: var(--ivory);
    font-variant-numeric: tabular-nums;
  }
  .stats__label {
    display: block;
    margin-top: 12px;
    font: 700 clamp(0.875rem, 1.1vw, 1rem) / 1.3 var(--font-display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ivory);
  }

  @media (max-width: 760px) {
    .stats__grid { grid-template-columns: 1fr 1fr; }
    .stats__item:nth-child(-n + 2) { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
    .stats__item:nth-child(even) { border-right: 0; }
  }
</style>
