---
/** Bandeau typographique défilant, posé sur une photo fixe assombrie. */
import FixedBg from './FixedBg.astro';

interface Props {
  words?: string[];
  /** Photo de fond (chemin dans src/assets/images/). */
  bg?: string;
}
const { words = ['Muralistique', 'Murs en mouvement'], bg = 'projects/cafe-nord/cover.jpeg' } = Astro.props;
const sequence = [...words, ...words];
---

<div class="band theme-ink" data-section-theme="ink" aria-hidden="true">
  <FixedBg src={bg} scrim={0.78} />
  <div class="band__track">
    {
      [0, 1].map(() => (
        <span class="band__group">
          {sequence.map((word, i) => (
            <>
              <span class:list={['band__word', i % 2 === 1 && 'band__word--outline']}>{word}</span>
              <span class="band__word band__word--outline">—</span>
            </>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  .band {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3rem, 6.5vw, 6rem);
    overflow: hidden;
    background: var(--ink);
  }
  .band__track {
    display: flex;
    width: max-content;
    animation: band-scroll 90s linear infinite;
  }
  .band:hover .band__track { animation-play-state: paused; }
  @keyframes band-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .band__group {
    display: flex;
    align-items: center;
    gap: 34px;
    padding-right: 34px;
  }
  .band__word {
    font: 700 clamp(2.75rem, 6.67vw, 6rem) / 1 var(--font-display);
    letter-spacing: var(--ls-display);
    text-transform: uppercase;
    color: var(--ivory);
    white-space: nowrap;
  }
  .band__word--outline {
    color: transparent;
    -webkit-text-stroke: 1.4px var(--ivory);
  }

  @media (prefers-reduced-motion: reduce) {
    .band__track { animation: none; }
    .band { overflow-x: auto; }
  }
</style>
