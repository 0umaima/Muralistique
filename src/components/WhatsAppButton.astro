---
/**
 * Bouton WhatsApp.
 *
 * Le numéro se configure dans src/data/site.mjs → contact.whatsappNumber.
 * Tant qu'il n'est pas renseigné, ce composant affiche un avertissement
 * visible au lieu d'un lien mort : impossible de mettre le site en ligne
 * sans s'en apercevoir.
 */
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';
import { whatsappUrl } from '../data/site.mjs';
import { getLang, useTranslations } from '../i18n';

interface Props {
  label?: string;
  class?: string;
  /** Style du bouton : 'primary' (aplat) | 'outline-light' */
  variant?: 'primary' | 'outline-light';
  block?: boolean;
}
const lang = getLang(Astro.url);
const t = useTranslations(lang).whatsapp;
const { label = t.open, class: className = '', variant = 'outline-light', block = false } = Astro.props;
const url = whatsappUrl(lang);
const variantClass = variant === 'primary' ? 'btn--primary' : 'btn--ghost-light';
---

{
  url ? (
    <a
      class:list={['btn', variantClass, block && 'btn--block', className]}
      href={url}
      target="_blank"
      rel="noopener noreferrer"
    >
      <BrandIcon name="whatsapp" size={18} />
      {label}
    </a>
  ) : (
    <p class:list={['wa-missing', className]} role="note">
      <Icon name="alert-circle" size={18} />
      <span>
        <strong>{t.missingTitle}</strong> {t.missingFill}
        <code>contact.whatsappNumber</code> {t.missingIn} <code>src/data/site.mjs</code> {t.missingEnd}
      </span>
    </p>
  )
}

<style>
  .wa-missing {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 18px;
    border: 1px dashed currentColor;
    border-radius: 14px;
    background: rgba(128, 128, 128, 0.08);
    color: inherit;
    font-size: var(--fs-xs);
    line-height: 1.5;
    text-align: left;
  }
  .wa-missing :global(svg) { flex: none; color: currentColor; margin-top: 1px; }
  .wa-missing code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.95em;
  }
</style>
