const { name, size = 20, stroke = 2, class: className = '', label } = Astro.props;
const path = PATHS[name];
if (!path) throw new Error(`Icône inconnue : ${name}`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={path}
/>
