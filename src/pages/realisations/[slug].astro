---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Media from '../../components/Media.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import ContactCta from '../../components/ContactCta.astro';
import { projects } from '../../data/projects';
import { sectorBySlug } from '../../data/sectors';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const sector = sectorBySlug(project.sector);

// Seuls les faits réellement renseignés sont affichés — rien n'est inventé.
const facts = [
  { label: 'Secteur', value: sector?.label ?? '' },
  { label: 'Ville', value: project.city },
  { label: 'Client', value: project.facts.client },
  { label: 'Surface', value: project.facts.surface },
  { label: 'Durée', value: project.facts.duration },
  { label: 'Année', value: project.facts.year },
].filter((fact) => Boolean(fact.value));
---

<BaseLayout
  title={project.title}
  description={`${project.title} — ${project.excerpt} Fresque murale réalisée par Muralistique à ${project.city}.`}
  headerTheme="ink"
  activeNav="/realisations"
  ogImage={project.cover.src}
>
  <article>
    <header class="detail-hero theme-ink" data-section-theme="ink">
      <div class="detail-hero__inner shell pad">
        <nav class="detail-hero__crumbs" aria-label="Fil d’Ariane">
          <a href="/realisations">Réalisations</a>
          <Icon name="chevron-right" size={13} stroke={2} />
          <span aria-current="page">{project.title}</span>
        </nav>

        <p class="eyebrow detail-hero__eyebrow">
          <Icon name="sparkle" size={13} stroke={1.6} />
          {sector?.label}
        </p>
        <h1 class="detail-hero__title">{project.title}</h1>
        <p class="detail-hero__lead">{project.excerpt}</p>
      </div>

      <div class="detail-hero__media shell pad">
        <Media
          src={project.cover.src}
          alt={project.cover.alt}
          ratio="16 / 9"
          widths={[700, 1100, 1600, 2200]}
          sizes="(max-width: 1500px) 100vw, 1320px"
          priority
          class="detail-hero__cover"
        />
      </div>
    </header>

    <section class="detail-body theme-ivory section" data-section-theme="ivory">
      <div class="shell pad detail-body__grid">
        <dl class="detail-facts" data-reveal>
          {
            facts.map((fact) => (
              <div class="detail-facts__row">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
          <div class="detail-facts__cta">
            <a class="btn btn--outline btn--md btn--block" href="/devis">
              Un projet similaire ?
              <Icon name="arrow-up-right" size={13} stroke={2.2} />
            </a>
          </div>
        </dl>

        <div class="detail-text" data-reveal data-reveal-delay="80">
          {project.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    {
      project.beforeAfter && (
        <section class="detail-ba theme-ivory-2 section" data-section-theme="ivory">
          <div class="shell pad">
            <div class="section-head" data-reveal>
              <div>
                <p class="eyebrow">
                  <Icon name="sparkle" size={13} stroke={1.6} />
                  Avant / après
                </p>
                <h2 class="detail-ba__title">La transformation, curseur en main.</h2>
              </div>
            </div>
            <div class="detail-ba__frame" data-reveal>
              <BeforeAfter
                id={`ba-${project.slug}`}
                before={project.beforeAfter.before}
                after={project.beforeAfter.after}
                ratio="2 / 1"
              />
            </div>
          </div>
        </section>
      )
    }

    {
      project.gallery.length > 0 && (
        <section class="detail-gallery theme-ivory section" data-section-theme="ivory">
          <div class="shell pad">
            <div class="section-head" data-reveal>
              <div>
                <p class="eyebrow">
                  <Icon name="sparkle" size={13} stroke={1.6} />
                  En images
                </p>
                <h2 class="detail-gallery__title">Le projet en détail.</h2>
              </div>
            </div>
            <ul class="detail-gallery__grid">
              {project.gallery.map((image, i) => (
                <li data-reveal data-reveal-delay={i * 80}>
                  <Media
                    src={image.src}
                    alt={image.alt}
                    ratio="4 / 3"
                    widths={[500, 800, 1200, 1600]}
                    sizes="(max-width: 800px) 100vw, 50vw"
                    zoom
                    class="detail-gallery__media"
                  />
                  {image.caption && (
                    <p class="detail-gallery__caption">
                      <span class="detail-gallery__dot" />
                      {image.caption}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <nav class="detail-next theme-ivory-2" aria-label="Projet suivant" data-section-theme="ivory">
      <a class="detail-next__link shell pad" href={`/realisations/${next.slug}`}>
        <span>
          <span class="detail-next__label">Projet suivant</span>
          <span class="detail-next__title">{next.title}</span>
        </span>
        <Icon name="arrow-right" size={26} stroke={2} />
      </a>
    </nav>
  </article>

  <ContactCta title="Votre mur, la prochaine transformation." />
</BaseLayout>

<style>
  .detail-hero { padding-block: clamp(2.5rem, 4.4vw, 4rem) 0; }
  .detail-hero__crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 500 var(--fs-xs) / 1 var(--font-body);
    color: var(--muted-on-dark);
  }
  .detail-hero__crumbs a:hover { color: var(--accent); }
  .detail-hero__eyebrow { margin-top: 28px; color: var(--muted-on-dark); }
  .detail-hero__title {
    margin-top: 22px;
    font-size: var(--fs-h1);
    line-height: 0.94;
    letter-spacing: var(--ls-display);
    color: var(--ivory);
    max-width: 16ch;
  }
  .detail-hero__lead {
    margin-top: 22px;
    max-width: 620px;
    font-size: var(--fs-body-lg);
    color: var(--muted-on-dark);
  }
  .detail-hero__media { margin-top: clamp(2rem, 4.4vw, 4rem); transform: translateY(clamp(1.75rem, 3.3vw, 3rem)); }
  .detail-hero__media :global(.detail-hero__cover) {
    border-radius: 24px;
    border: 1px solid var(--ink-line-2);
  }

  .detail-body { padding-top: clamp(4.5rem, 10vw, 9rem); }
  .detail-body__grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: clamp(2rem, 5.5vw, 5rem);
    align-items: start;
  }

  .detail-facts { margin: 0; border-top: 1px solid var(--ink); }
  .detail-facts__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }
  .detail-facts dt {
    font: 600 var(--fs-eyebrow) / 1.4 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-on-light);
  }
  .detail-facts dd { margin: 0; font-size: var(--fs-body-sm); font-weight: 500; text-align: right; }
  .detail-facts__cta { margin-top: 28px; }

  .detail-text {
    display: flex;
    flex-direction: column;
    gap: 22px;
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--muted-on-light);
    max-width: 66ch;
  }

  .detail-ba { border-top: 1px solid var(--ink); }
  .detail-ba__title, .detail-gallery__title { margin-top: 22px; font-size: var(--fs-h2-sm); }
  .detail-ba__frame { margin-top: clamp(2rem, 3.3vw, 3rem); }

  .detail-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: clamp(2rem, 3.3vw, 3rem);
  }
  .detail-gallery__grid :global(.detail-gallery__media) {
    border-radius: 22px;
    border: 1px solid var(--ink);
  }
  .detail-gallery__caption {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    font: 500 0.84375rem/1 var(--font-body);
    color: var(--muted-on-light);
  }
  .detail-gallery__dot { width: 7px; height: 7px; background: var(--accent); flex: none; }

  .detail-next { border-top: 1px solid var(--ink); }
  .detail-next__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: clamp(2rem, 3.9vw, 3.5rem);
    transition: background-color 240ms var(--ease);
  }
  .detail-next__link:hover { background: var(--accent); }
  .detail-next__label {
    display: block;
    font: 600 var(--fs-eyebrow) / 1 var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-on-light);
  }
  .detail-next__title {
    display: block;
    margin-top: 14px;
    font: 700 var(--fs-h2-sm) / 1 var(--font-display);
    letter-spacing: var(--ls-display);
  }
  .detail-next__link :global(svg) { flex: none; transition: transform 240ms var(--ease); }
  .detail-next__link:hover :global(svg) { transform: translateX(6px); }

  @media (max-width: 900px) {
    .detail-body__grid { grid-template-columns: 1fr; }
    .detail-gallery__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { initReveal } from '../../scripts/reveal';
  initReveal();
</script>
