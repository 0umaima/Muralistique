---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectsBrowser from '../../components/ProjectsBrowser.astro';
import ContactCta from '../../components/ContactCta.astro';
import { projects } from '../../data/projects';

const title = 'Réalisations';
---

<BaseLayout
  title="Réalisations"
  description="Fresques murales réalisées par Muralistique pour des hôtels, cliniques, écoles, commerces, bureaux et espaces privés. Avant / après, secteur par secteur."
  headerTheme="ink"
  activeNav="/realisations"
>
  <section class="phero theme-ink" data-section-theme="ink">
    <div class="phero__inner shell pad">
      <h1 class="phero__title" aria-label={title}>
        <span class="phero__mask" aria-hidden="true">
          {[...title].map((letter, i) => <span class="phero__letter" style={`--i:${i}`}>{letter}</span>)}
        </span>
      </h1>
      <div class="phero__side">
        <p class="phero__count">
          <span class="phero__num">{String(projects.length).padStart(2, '0')}</span>
          projets
        </p>
        <p class="phero__lead">Nos murs, en grand. Survolez une image pour découvrir le projet.</p>
      </div>
    </div>
  </section>

  <ProjectsBrowser />
  <ContactCta title="Parlons projet." />
</BaseLayout>

<style>
  .phero { padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 3.5vw, 3rem); }

  .phero__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px clamp(2rem, 4vw, 4rem);
    flex-wrap: wrap;
  }

  .phero__title {
    font-size: clamp(3.75rem, 13vw, 12.5rem);
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: 0;
    color: var(--ivory);
  }
  .phero__mask { display: block; overflow: hidden; padding-top: 0.08em; }
  .phero__letter { display: inline-block; }

  .phero__side {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 300px;
    padding-bottom: 0.6em;
  }
  .phero__count {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font: 700 0.875rem/1 var(--font-display);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
  }
  .phero__num {
    font: 800 clamp(2.5rem, 4vw, 3.75rem) / 1 var(--font-display);
    letter-spacing: 0;
    color: var(--accent);
  }
  .phero__lead { font-size: var(--fs-body-sm); color: var(--muted-on-dark); }

  /* Entrée : les lettres montent une à une derrière leur masque. */
  :global(.js) .phero__letter { animation: p-rise 800ms var(--ease-out) calc(var(--i) * 35ms) both; }
  :global(.js) .phero__side { animation: p-fade 700ms var(--ease-out) 450ms both; }
  :global(.js) .phero + :global(.browser) :global(.browser__bar) { animation: p-fade 700ms var(--ease-out) 550ms both; }

  @keyframes p-rise {
    from { transform: translateY(105%); }
    to { transform: none; }
  }
  @keyframes p-fade {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 700px) {
    .phero__side { padding-bottom: 0; }
  }
</style>

<script>
  import { initReveal } from '../../scripts/reveal';
  initReveal();
</script>
