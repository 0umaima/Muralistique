# En-têtes HTTP servis par Cloudflare Pages (et Netlify, même format).
# Ce fichier est copié tel quel dans dist/ au build.

# Ressources versionnées par Astro (le nom contient un hachage) : cache long.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Polices auto-hébergées : elles ne changent jamais sous ce nom.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=604800

# En-têtes de sécurité, sur toutes les réponses.
# Pas de Cache-Control ici : cette règle s'applique AUSSI à /_astro/* et
# /fonts/*, et Cloudflare y concatène les deux valeurs (cache long annulé).
# Les pages HTML reçoivent déjà par défaut « public, max-age=0, must-revalidate ».
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
