# En-têtes HTTP servis par Cloudflare Pages (et Netlify, même format).
# Ce fichier est copié tel quel dans dist/ au build.

# Ressources versionnées par Astro (le nom contient un hachage) : cache long.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Polices auto-hébergées : elles ne changent jamais sous ce nom.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=604800

# Pages HTML : revalidation à chaque visite, mise en cache côté CDN.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
