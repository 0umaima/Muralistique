// Cloudflare Workers — serves the static `dist/` folder produced by
// `npm run build`, exactly as built (no server code, no adapter).
// Without this file, `npx wrangler deploy` auto-installs the Astro Cloudflare
// adapter on every build. `name` must match the Worker's name in the dashboard.
{
  "name": "muralistique",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Adresses sans barre finale (/devis), comme les liens internes, les
    // balises canonical et le sitemap : /devis est servi directement et
    // /devis/ redirige vers /devis. Par défaut, Cloudflare faisait l'inverse,
    // et Google voyait chaque canonical pointer vers une redirection.
    "html_handling": "drop-trailing-slash"
  },
  // Required by `npx wrangler preview`, the command Cloudflare runs for
  // branches and pull requests. Empty: previews reuse the settings above.
  "previews": {}
}
